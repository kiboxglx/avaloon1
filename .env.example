VITE_APIFY_TOKEN=your_apify_token_here
VITE_SUPABASE_KEY=your_supabase_anon_key_here

# --- Stories tracking (opcional) ---
# sessionid de uma conta de Instagram DEDICADA ao scraping (NUNCA a principal).
# Pegue em DevTools > Application > Cookies > instagram.com > sessionid (apos login).
# Sem este valor, o app usa MOCK de stories (posts seguem funcionando normalmente).
VITE_APIFY_IG_SESSIONID=
# Actor de stories (default: automation-lab~instagram-stories-scraper). So mude se trocar de fornecedor.
VITE_APIFY_STORY_ACTOR_ID=
